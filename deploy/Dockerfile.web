# Development image for the SPA: Vite's dev server, with the API proxied through
# it so the browser sees a single origin and the session cookie stays
# first-party. A production image would build to static files and serve them
# from the same origin as the API instead.
FROM node:26-alpine AS deps
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci

FROM node:26-alpine AS dev
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY web/ ./
EXPOSE 5173
CMD ["npm", "run", "dev"]

# Production: a static bundle behind nginx.
FROM deps AS build
COPY web/ ./
RUN npm run build

FROM nginx:1.27-alpine AS production
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
