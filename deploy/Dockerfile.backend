# Multi-stage build shared by every backend binary. Each binary gets its own
# final stage so that "target: api" and "target: worker" in compose produce
# minimal, single-purpose images.
#
# It is written for kaniko as much as for docker: no cache mounts, which
# kaniko ignores, and the dependency compile in a layer of its own that stays
# cached until the imports change, so a commit compiles Armature's own
# packages and nothing else.

FROM golang:1.26-alpine AS modules
WORKDIR /src
ENV GOFLAGS=-buildvcs=false
# Dependencies first: this layer is cached until go.mod or go.sum changes.
COPY backend/go.mod backend/go.sum ./
RUN go mod download

# The packages the binaries import from outside the module, as a list whose
# content changes only when an import does. The stage itself is rebuilt every
# time the source changes; listing is cheap, and what matters is the layer
# below that reads the list.
FROM modules AS deplist
COPY backend/ ./
RUN go list -deps -f '{{if and (not .Standard) (ne .Module.Path "github.com/armature/armature/backend")}}{{.ImportPath}}{{end}}' ./cmd/... | sort -u > /deps.txt

FROM modules AS builder
# Compiling the dependencies fills the build cache in this layer, keyed on
# the list alone, so the cache survives every commit that keeps its imports.
# The flags match the final build's, or the cache would not be consulted.
COPY --from=deplist /deps.txt /deps.txt
RUN go build -trimpath $(cat /deps.txt)

COPY backend/ ./

# The goose build tags drop database drivers we will never use; without them the
# migrate binary carries an embedded sqlite, mysql and clickhouse driver.
ARG GOOSE_TAGS="no_sqlite3 no_mysql no_clickhouse no_vertica no_ydb no_libsql no_mssql no_turso no_duckdb"
ARG CGO_ENABLED=0

# What the running build says it is, shown at the foot of the screen. The
# values may be passed in, and are otherwise read from the repository's own
# history, which the build context carries in .git. As semver: 1.2.3 on the
# tag v1.2.3, 1.2.3+4.gabc1234 four commits past it, and VERSION+dev when no
# tag is reachable, as in a shallow clone of a branch.
ARG VERSION=""
ARG COMMIT=""
ARG BUILT_AT=""
RUN apk add --no-cache git && git config --global --add safe.directory /src
COPY .git /src/.git
COPY VERSION /VERSION

# One invocation for the three plain binaries: the shared packages are
# compiled once and linked three times.
RUN VERSION="${VERSION:-$(git describe --tags --match 'v[0-9]*' 2>/dev/null | sed -E 's/^v//; s/-([0-9]+)-g([0-9a-f]+)$/+\1.g\2/' | grep . || echo "$(cat /VERSION)+dev")}" && \
    COMMIT="${COMMIT:-$(git rev-parse HEAD)}" && \
    BUILT_AT="${BUILT_AT:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}" && \
    LDFLAGS="-s -w -X github.com/armature/armature/backend/internal/buildinfo.Version=$VERSION -X github.com/armature/armature/backend/internal/buildinfo.Commit=$COMMIT -X github.com/armature/armature/backend/internal/buildinfo.BuiltAt=$BUILT_AT" && \
    go build -trimpath -ldflags="$LDFLAGS" -o /out/ ./cmd/api ./cmd/worker ./cmd/seed && \
    go build -trimpath -ldflags="$LDFLAGS" -tags "$GOOSE_TAGS" -o /out/migrate ./cmd/migrate

# A shared runtime base: no shell-less scratch, because the health checks and
# the replica bootstrap both benefit from having a shell available.
FROM alpine:3.22 AS runtime
RUN apk add --no-cache ca-certificates tzdata && \
    adduser -D -u 10001 armature
WORKDIR /app
USER armature

FROM runtime AS api
COPY --from=builder /out/api /app/api
EXPOSE 8080
ENTRYPOINT ["/app/api"]

FROM runtime AS worker
COPY --from=builder /out/worker /app/worker
ENTRYPOINT ["/app/worker"]

FROM runtime AS migrate
COPY --from=builder /out/migrate /app/migrate
ENTRYPOINT ["/app/migrate"]
CMD ["up"]

FROM runtime AS seed
COPY --from=builder /out/seed /app/seed
ENTRYPOINT ["/app/seed"]
