#!/bin/sh
# Refuses to push a branch whose name, or any commit not yet on the remote's
# main, the release script could not read. make hooks turns it on.
set -u

conventions="$(dirname "$0")/../deploy/conventions.sh"
remote=$1
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
	case $remote_ref in
	refs/heads/*) ;;
	*) continue ;;
	esac
	# A deleted ref is pushed as a hash of zeros.
	case $local_sha in
	*[!0]*) ;;
	*) continue ;;
	esac
	sh "$conventions" branch "${remote_ref#refs/heads/}" || status=1
	if git rev-parse -q --verify "refs/remotes/$remote/main" >/dev/null; then
		sh "$conventions" range "$remote/main" "$local_sha" || status=1
	fi
done

exit $status
